# =============================================================================
# VPS Production Deployment Configuration Template
# =============================================================================
# CRITICAL SECURITY WARNING: 
# This is a template file. DO NOT use these placeholder values in production!
# 
# Instructions for VPS deployment:
# 1. Copy this file to .env on your VPS
# 2. Generate STRONG, UNIQUE passwords for ALL secrets (see commands below)
# 3. Replace ALL placeholder values with production values
# 4. Set restrictive file permissions: chmod 600 .env
# 5. Never commit the actual .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# VPS Connection Information
# -----------------------------------------------------------------------------
VPS_HOST=57.129.110.129
VPS_USERNAME=debian
# SECURITY: Change the VPS password immediately after first login
VPS_PASSWORD=CHANGE_THIS_IMMEDIATELY_AFTER_FIRST_LOGIN

# -----------------------------------------------------------------------------
# Supabase Configuration (Frontend)
# -----------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=schoolmanagement
POSTGRES_USER=postgres
# SECURITY CRITICAL: Generate strong password
# Command: openssl rand -base64 32
POSTGRES_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# -----------------------------------------------------------------------------
# pgAdmin Configuration
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@pedagoria.com
# SECURITY: Generate strong password
# Command: openssl rand -base64 32
PGADMIN_DEFAULT_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
# SECURITY: MinIO access key (minimum 20 characters)
# Command: openssl rand -base64 20
MINIO_ROOT_USER=GENERATE_WITH_OPENSSL_RAND_BASE64_20
# SECURITY: MinIO secret key (minimum 40 characters)
# Command: openssl rand -base64 32
MINIO_ROOT_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32
MINIO_SERVER_URL=https://pedagoria.com/minio

# -----------------------------------------------------------------------------
# Backend Spring Boot Configuration
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/schoolmanagement
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# MinIO Connection (Internal Docker network)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_20
MINIO_SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32
MINIO_BUCKET_NAME=school-management

# JWT Security Configuration
# SECURITY CRITICAL: Generate cryptographically secure 512-bit (64 bytes) secret
# Command: openssl rand -base64 64
# This is THE MOST CRITICAL secret - keep it absolutely secure
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_64_THIS_IS_CRITICAL
JWT_EXPIRATION=86400000

# Application Configuration
APP_BASE_URL=https://pedagoria.com

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# HikariCP Connection Pool (Optional Tuning)
# -----------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION=60000

# =============================================================================
# SECURITY CHECKLIST BEFORE PRODUCTION DEPLOYMENT:
# =============================================================================
# [ ] All passwords changed from defaults
# [ ] JWT_SECRET generated with: openssl rand -base64 64
# [ ] PostgreSQL password generated with: openssl rand -base64 32
# [ ] MinIO credentials generated with: openssl rand -base64 20/32
# [ ] pgAdmin password changed
# [ ] File permissions set to 600: chmod 600 .env
# [ ] .env added to .gitignore
# [ ] SSL/TLS certificate configured (Let's Encrypt)
# [ ] Firewall configured (ufw enable, only ports 22, 80, 443)
# [ ] CORS configured to allow only production domain
# [ ] Database backups configured
# =============================================================================
