# =============================================================================
# LSTA Academy - Environment Configuration Template
# =============================================================================
# SECURITY WARNING: This is a template file with placeholder values.
# DO NOT use these values in production!
# 
# Instructions:
# 1. Copy this file to .env
# 2. Generate strong, unique passwords for each secret
# 3. Never commit the actual .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Frontend)
# -----------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=schoolmanagement
POSTGRES_USER=postgres
# SECURITY: Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_32_CHARS_MIN

# -----------------------------------------------------------------------------
# pgAdmin Configuration
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
# SECURITY: Generate with: openssl rand -base64 32
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_32_CHARS_MIN
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
# SECURITY: MinIO access key should be 20+ characters
# Generate with: openssl rand -base64 20
MINIO_ROOT_USER=CHANGE_THIS_MINIO_ACCESS_KEY_20_CHARS_MIN
# SECURITY: MinIO secret key should be 40+ characters
# Generate with: openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_SECRET_KEY_40_CHARS_MIN
MINIO_SERVER_URL=https://yourdomain.com/minio

# -----------------------------------------------------------------------------
# Backend Spring Boot Configuration
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/schoolmanagement
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_32_CHARS_MIN

# MinIO Connection (Internal Docker network)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY_20_CHARS_MIN
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY_40_CHARS_MIN
MINIO_BUCKET_NAME=school-management

# JWT Security Configuration
# SECURITY CRITICAL: Generate a cryptographically secure 512-bit (64 bytes) secret
# Generate with: openssl rand -base64 64
# This must be kept absolutely secret and never exposed
JWT_SECRET=CHANGE_THIS_JWT_SECRET_512_BITS_REQUIRED_USE_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION=86400000

# Application Base URL (for file download links)
APP_BASE_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# HikariCP Connection Pool (Optional Tuning)
# -----------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION=60000
